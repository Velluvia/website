# --- Site ---
# Full production URL, no trailing slash. Used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.velluvia.co.uk

# --- Stripe (Payments) ---
# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Stripe Webhook (order confirmation emails) ---
# From Stripe Dashboard > Developers > Webhooks > Add endpoint, pointing at:
#   https://www.velluvia.co.uk/api/webhooks/stripe
# listening for the "checkout.session.completed" event. Copy the "Signing secret"
# shown after creating the endpoint (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# --- Cron (scheduled review-request emails) ---
# Any random secure string you choose (e.g. generate one in a password manager).
# Vercel automatically sends this as a Bearer token when it triggers the
# scheduled job defined in vercel.json — this just needs to exist and match.
CRON_SECRET=

# --- AI Chat Assistant ---
# Get a key from https://console.anthropic.com — Settings > API Keys
# Without this set, the chat widget still works but immediately hands every
# conversation to the team by email instead of answering directly.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Optional: override the model used for chat replies. Anthropic periodically retires
# older models (check https://platform.claude.com/docs/en/about-claude/model-deprecations) —
# if the chat widget ever starts silently failing again, this is the first thing to check.
CHAT_MODEL=claude-haiku-4-5

# --- Product Reviews (Neon Postgres) ---
# Vercel's native "Vercel Postgres" is discontinued — Postgres is now provided via the
# Vercel Marketplace, powered by Neon. Create one: Vercel Dashboard > your project >
# Storage > Create Database > choose "Neon" (listed under Marketplace Database Providers).
# Connecting it to this project auto-injects DATABASE_URL below — you don't set this by hand.
# DATABASE_URL is auto-populated by Vercel once a Neon database is connected.

# --- Email sending (Resend) ---
# Website email (order confirmations, contact form, review/occasion reminders) sends via
# Resend, not Zoho — Zoho Mail's free plan blocks external SMTP/IMAP/POP access entirely for
# new accounts (confirmed in Zoho's own docs), so no SMTP password would ever have worked
# for outbound sending on that plan. hello@velluvia.co.uk still works completely normally
# for RECEIVING email in Zoho's free webmail — this only changes how the site sends mail out.
#
# Setup:
#   1. Create a free account at resend.com (3,000 emails/month free — plenty for this site)
#   2. Add and verify velluvia.co.uk as a sending domain: Resend > Domains > Add Domain,
#      then add the DNS records it gives you (similar process to the Zoho SPF/DKIM records
#      already set up at your DNS provider — these are additional records, not replacements)
#   3. Create an API key: Resend > API Keys > Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# The "from" address for outgoing mail — must be at the domain verified in step 2 above.
# IMPORTANT: no quote marks around the value when entering this in Vercel — literal " characters
# pasted into the field break Resend's format check with a confusing "Invalid `from` field" error.
EMAIL_FROM=Velluvia <hello@velluvia.co.uk>
# Where contact form submissions and new-order notifications should be delivered
CONTACT_TO_EMAIL=hello@velluvia.co.uk

# --- Meta Pixel (Facebook/Instagram ad tracking) ---
# From Meta Events Manager > Connect data > Set up Meta Pixel > Copy base code — this is just
# the ID inside that code (the number passed to fbq('init', '...')), not the full script.
# Public by design (visible in every page's source), so no risk in setting this directly.
NEXT_PUBLIC_META_PIXEL_ID=877135835335099
