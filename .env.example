# --- Site ---
# Full production URL, no trailing slash. Used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.velluvia.co.uk

# --- Stripe (Payments) ---
# Secret key from https://dashboard.stripe.com/apikeys — starts with sk_live_ or sk_test_
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# --- Stripe Webhook (order confirmation emails) ---
# From Stripe Dashboard > Developers > Webhooks > Add endpoint, pointing at:
#   https://www.velluvia.co.uk/api/webhooks/stripe
# listening for the "checkout.session.completed" event. Copy the "Signing secret"
# shown after creating the endpoint (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# --- Cron (scheduled review-request emails) ---
# Any random secure string you choose (e.g. generate one in a password manager).
# Vercel automatically sends this as a Bearer token when it triggers the
# scheduled job defined in vercel.json — this just needs to exist and match.
CRON_SECRET=

# --- AI Chat Assistant ---
# Get a key from https://console.anthropic.com — Settings > API Keys
# Without this set, the chat widget still works but immediately hands every
# conversation to the team by email instead of answering directly.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Optional: override the model used for chat replies
CHAT_MODEL=claude-3-5-haiku-latest

# --- Product Reviews (Neon Postgres) ---
# Vercel's native "Vercel Postgres" is discontinued — Postgres is now provided via the
# Vercel Marketplace, powered by Neon. Create one: Vercel Dashboard > your project >
# Storage > Create Database > choose "Neon" (listed under Marketplace Database Providers).
# Connecting it to this project auto-injects DATABASE_URL below — you don't set this by hand.
# DATABASE_URL is auto-populated by Vercel once a Neon database is connected.

# --- Zoho Mail (Contact form + order notifications) ---
# Use smtp.zoho.com (US/global) or smtp.zoho.eu (EU) — match your Zoho Mail data centre
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@velluvia.co.uk
# Generate an app-specific password in Zoho Mail: Settings > Security > App Passwords
ZOHO_SMTP_PASS=your-zoho-app-password
# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=hello@velluvia.co.uk
